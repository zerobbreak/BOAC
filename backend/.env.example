# Local: public Railway TCP proxy URL. On Railway, MONGO_URL is used when MONGODB_URI is unset.
MONGODB_URI=
MONGODB_DB=boac

# Better Auth. Secret must be at least 32 characters. URL is this API, not the React app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# React dev server origin. CORS and trustedOrigins allow this origin to send the session cookie.
FRONTEND_ORIGIN=http://localhost:5173

# First admin account. Created when this email is not already a Better Auth user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# First volunteer account. Created when this email is not already a Better Auth user.
VOLUNTEER_EMAIL=
VOLUNTEER_PASSWORD=

# Railway bucket credentials (AWS SDK names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=
