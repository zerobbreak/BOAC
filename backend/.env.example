# Local: public Railway TCP proxy URL. On Railway, MONGO_URL is used when MONGODB_URI is unset.
MONGODB_URI=
MONGODB_DB=boac

# Signs the admin session cookie and bearer token. At least 32 characters.
JWT_SECRET=

# First admin account. Created when this email is not already a user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Railway bucket credentials (AWS SDK names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET_NAME=
